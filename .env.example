# Copie para o EasyPanel em: App → Environment. NUNCA suba o .env para o GitHub.

# Senha inicial dos ADMs (benati@ e lucas@). Usada só na primeira vez que o servidor liga.
ADMIN_SEED_PASSWORD=troque-por-uma-senha-forte
# ADMIN_EMAILS=benati@mgeotecnologia.com,lucas@mgeotecnologia.com

# E-mail para "Esqueci minha senha" (o mesmo SMTP do e-mail da empresa)
SMTP_HOST=smtp.seuprovedor.com.br
SMTP_PORT=587
SMTP_USER=naoresponda@mgeotecnologia.com
SMTP_PASS=senha-do-email
SMTP_FROM="MGEO PDF <naoresponda@mgeotecnologia.com>"

# Login com o usuário do Portal MGEO (já vem ligado; nada disso é obrigatório)
# PORTAL_LOGIN=0                      # desliga o login pelo portal
# PAPEIS_GERENCIAL=admin,comercial    # papéis do portal que entram no modo gerencial
# SUPABASE_URL=https://supabase-supabase.yzw8ui.easypanel.host
# SUPABASE_ANON_KEY=...               # só se a chave pública do portal mudar
